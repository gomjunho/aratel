<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ARATEL - VVIP Verification & Tier Governance" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar">
      <div class="nav-brand">
        <a href="/" class="logo">ARATEL <span>아라뜰</span></a>
      </div>
      <div class="nav-links">
        <a href="<%= verification_path %>" class="nav-item">인증 대시보드</a>
        <a href="<%= new_tier_evidence_path %>" class="nav-item">자산 증빙 제출</a>
        <a href="<%= admin_verifications_path %>" class="nav-item nav-admin">어드민 심사 대기열</a>
      </div>
    </nav>

    <main class="container">
      <% if notice %>
        <div class="alert alert-success"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="alert alert-warning"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>

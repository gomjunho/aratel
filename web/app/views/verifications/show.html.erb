<div class="security-glow-frame p-3" style="margin-bottom: 24px;">
  <div class="dashboard-header" style="margin-bottom: 0;">
    <div style="display: flex; align-items: center; gap: 10px;">
      <h1 style="margin: 0;">인증 및 멤버십 대시보드 | ARATEL Verification</h1>
      <span class="status-badge" style="background: rgba(212, 175, 55, 0.15); color: var(--gold-primary); border: 1px solid var(--gold-primary); font-size: 11px;">🛡️ 보안모드 (FLAG_SECURE)</span>
    </div>
    <p class="subtitle">대한민국 상위 0.1% VVIP 전용 주거 자산 인증 및 등급 관리 시스템</p>
  </div>
</div>

<!-- Multi-Step Ownership Verification Wizard Stepper -->
<% 
  step1_done = @user.verification_token.present?
  step2_done = @user.complex_name.present?
  step3_done = @tier_evidences.any? || @delegated_access_requests.any?
  progress_pct = (step1_done ? 33 : 0) + (step2_done ? 33 : 0) + (step3_done ? 34 : 0)
%>
<div class="verification-wizard-stepper">
  <div class="card-header-flex">
    <div>
      <h3 style="margin:0; font-size:1.1rem; color:var(--gold-primary);">🔐 소유권 자동 인증 및 자산 증빙 마법사</h3>
      <p class="text-muted" style="margin:0.2rem 0 0 0; font-size:0.85rem;">단계별 무결성 검증 진행률: <strong><%= progress_pct %>%</strong></p>
    </div>
    <%= form_with url: trust_api_sync_verification_path, method: :post, local: true, class: "inline-form" do |f| %>
      <%= hidden_field_tag :verification_token, @user.verification_token || "ver_tok_sample" %>
      <%= hidden_field_tag :complex_name, @user.complex_name || "디에이치 방배" %>
      <%= hidden_field_tag :building_number, @user.building_number || "101동" %>
      <%= hidden_field_tag :unit_number, @user.unit_number || "1502호" %>
      <%= button_tag "⚡ 1-Tap 등기부 자동 재시도", type: :submit, class: "btn btn-xs btn-gold" %>
    <% end %>
  </div>

  <div class="wizard-progress-bar">
    <div class="wizard-progress-fill" style="width: <%= progress_pct %>%;"></div>
  </div>

  <div class="wizard-steps-grid">
    <div class="step-wizard-item <%= step1_done ? 'completed' : 'active' %>">
      <span class="step-number">STEP 1</span>
      <div class="step-title">휴대폰 본인인증</div>
      <span class="status-tag <%= step1_done ? 'status-verified' : 'status-pending_owner_approval' %>">
        <%= step1_done ? '✓ 인증 완료' : '진행 대기' %>
      </span>
    </div>

    <div class="step-wizard-item <%= step2_done ? 'completed' : (step1_done ? 'active' : '') %>">
      <span class="step-number">STEP 2</span>
      <div class="step-title">1분 실시간 등기부 연동</div>
      <span class="status-tag <%= step2_done ? 'status-verified' : 'status-pending_owner_approval' %>">
        <%= step2_done ? '✓ 등기 매칭 완료' : '연동 필요' %>
      </span>
    </div>

    <div class="step-wizard-item <%= step3_done ? 'completed' : (step2_done ? 'active' : '') %>">
      <span class="step-number">STEP 3</span>
      <div class="step-title">VVIP 자산 증빙 및 위임</div>
      <span class="status-tag <%= step3_done ? 'status-verified' : 'status-pending_owner_approval' %>">
        <%= step3_done ? '✓ 제출 완료' : '서류 제출 대기' %>
      </span>
    </div>
  </div>
</div>

<div class="grid grid-2">
  <!-- Tier & Badges Card -->
  <div class="card tier-card tier-<%= @user.tier.downcase %>">
    <div class="tier-header">
      <span class="tier-label">MEMBERSHIP TIER</span>
      <h2 class="tier-title"><%= @user.tier %></h2>
    </div>

    <div class="badges-section">
      <h3>보유 뱃지 (Badges)</h3>
      <div class="badge-list">
        <% @user.badges.each do |b| %>
          <span class="badge badge-<%= b.downcase %>"><%= b %></span>
        <% end %>
      </div>
    </div>

    <div class="property-info">
      <h3>인증 자산 정보</h3>
      <% if @user.complex_name.present? %>
        <p class="property-detail"><strong>단지명:</strong> <%= @user.complex_name %></p>
        <p class="property-detail"><strong>동/호수:</strong> <%= @user.building_number %> <%= @user.unit_number %></p>
        <p class="property-detail"><strong>소유 지분:</strong> <%= @user.ownership_percentage %>%</p>
      <% else %>
        <p class="text-muted">등록된 등기 자산이 없습니다. 아래 등기부 연동을 진행해주세요.</p>
      <% end %>
    </div>

    <div class="security-profile">
      <h3>보안 프로필 (Security Profile)</h3>
      <div class="security-flags">
        <span class="security-tag <%= @user.screen_capture_prevented ? 'active' : '' %>">
          🔒 화면 캡처 방지: <%= @user.screen_capture_prevented ? 'ON' : 'OFF' %>
        </span>
        <span class="security-tag <%= @user.privacy_masked ? 'active' : '' %>">
          👁️ 개인정보 마스킹: <%= @user.privacy_masked ? 'ON' : 'OFF' %>
        </span>
      </div>
    </div>
  </div>

  <!-- Actions & Submissions -->
  <div class="card-stack">
    <!-- Identity Auth Form -->
    <div class="card">
      <h3>1. 휴대폰 본인확인 (Identity Verification)</h3>
      <%= form_with url: identity_verify_verification_path, method: :post, local: true do |f| %>
        <div class="form-group">
          <%= f.label :name, "이름" %>
          <%= f.text_field :name, value: @user.name, class: "form-control", required: true %>
        </div>
        <div class="form-group">
          <%= f.label :phone_number, "휴대폰 번호" %>
          <%= f.text_field :phone_number, value: @user.phone_number, class: "form-control", required: true %>
        </div>
        <div class="form-group">
          <%= f.label :birth_date, "생년월일 (YYYYMMDD)" %>
          <%= f.text_field :birth_date, value: @user.birth_date, class: "form-control", required: true %>
        </div>
        <%= f.submit "본인확인 진행", class: "btn btn-primary" %>
      <% end %>
      <% if @user.verification_token.present? %>
        <div class="token-info">
          <p><strong>인증 토큰:</strong> <code><%= @user.verification_token %></code></p>
          <p><strong>마스킹 이름:</strong> <%= @user.masked_name %></p>
        </div>
      <% end %>
    </div>

    <!-- Trust API Sync Form -->
    <div class="card">
      <h3>2. 1분 자동 등기부 연동 (Trust API Sync)</h3>
      <%= form_with url: trust_api_sync_verification_path, method: :post, local: true do |f| %>
        <%= hidden_field_tag :verification_token, @user.verification_token || "ver_tok_sample" %>
        <div class="form-group">
          <%= label_tag :complex_name, "단지명" %>
          <%= text_field_tag :complex_name, @user.complex_name || "디에이치 방배", class: "form-control", required: true %>
        </div>
        <div class="form-group">
          <%= label_tag :building_number, "동" %>
          <%= text_field_tag :building_number, @user.building_number || "101동", class: "form-control", required: true %>
        </div>
        <div class="form-group">
          <%= label_tag :unit_number, "호수" %>
          <%= text_field_tag :unit_number, @user.unit_number || "1502호", class: "form-control", required: true %>
        </div>
        <%= submit_tag "등기부 자동 연동", class: "btn btn-accent" %>
      <% end %>
    </div>
  </div>
</div>

<div class="grid grid-2 mt-4">
  <!-- Delegated Access Form & History -->
  <div class="card">
    <h3>3. 대리인 및 가족 권한 위임 신청</h3>
    <%= form_with model: DelegatedAccessRequest.new, url: delegated_accesses_path, local: true do |f| %>
      <div class="form-group">
        <%= f.label :relationship, "관계 (FAMILY / AGENT)" %>
        <%= f.select :relationship, [["가족 (FAMILY)", "FAMILY"], ["대리인 (AGENT)", "AGENT"]], {}, class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :document_url, "증빙 서류 URL" %>
        <%= f.text_field :document_url, placeholder: "https://storage.aratel.com/docs/family_rel.pdf", class: "form-control", required: true %>
      </div>
      <%= f.submit "위임 신청 제출", class: "btn btn-secondary" %>
    <% end %>

    <h4 class="mt-3">내 위임 신청 내역</h4>
    <% if @delegated_access_requests.any? %>
      <table class="table">
        <thead>
          <tr>
            <th>ID</th>
            <th>관계</th>
            <th>상태</th>
            <th>신청일</th>
            <th>작업</th>
          </tr>
        </thead>
        <tbody>
          <% @delegated_access_requests.each do |req| %>
            <tr>
              <td><%= req.delegation_id %></td>
              <td><%= req.relationship %></td>
              <td><span class="status-tag status-<%= req.status.downcase %>"><%= req.status %></span></td>
              <td><%= req.requested_at&.strftime("%Y-%m-%d %H:%M") %></td>
              <td>
                <% if req.status == "PENDING_OWNER_APPROVAL" %>
                  <%= button_to "승인", approve_delegated_access_path(req, approved: true), method: :post, class: "btn btn-xs btn-success" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted">신청된 위임 내역이 없습니다.</p>
    <% end %>
  </div>

  <!-- VVIP Tier Evidence Submissions List -->
  <div class="card">
    <div class="card-header-flex">
      <h3>4. VVIP 자산 증빙 제출 내역</h3>
      <%= link_to "새 증빙 제출", new_tier_evidence_path, class: "btn btn-sm btn-gold" %>
    </div>

    <% if @tier_evidences.any? %>
      <table class="table">
        <thead>
          <tr>
            <th>제출 ID</th>
            <th>증빙 유형</th>
            <th>목표 등급</th>
            <th>상태</th>
            <th>상세</th>
          </tr>
        </thead>
        <tbody>
          <% @tier_evidences.each do |ev| %>
            <tr>
              <td><%= ev.submission_id %></td>
              <td><%= ev.evidence_type %></td>
              <td><strong><%= ev.target_tier %></strong></td>
              <td><span class="status-tag status-<%= ev.status.downcase %>"><%= ev.status %></span></td>
              <td><%= link_to "보기", tier_evidence_path(ev), class: "btn btn-xs btn-outline" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-muted">제출된 자산 증빙 내역이 없습니다. Diamond/Platinum 등급 산정을 위해 증빙 자료를 제출하세요.</p>
    <% end %>
  </div>
</div>

<% if @complex.present? %>
  <style>
    :root {
      --complex-primary: <%= @complex.primary_color %>;
      --complex-secondary: <%= @complex.secondary_color %>;
      --complex-accent: <%= @complex.accent_color %>;
    }
  </style>
<% end %>

<div class="welcome-home-container" style="padding: 24px; max-width: 1000px; margin: 0 auto; font-family: 'Noto Sans KR', sans-serif;">
  <% if user_signed_in? %>
    <!-- Authenticated Resident View with Dynamic Satin Gold & Complex Branding -->
    <header class="tier-card" style="margin-bottom: 32px; padding: 28px; border-radius: 16px; box-shadow: 0 8px 24px rgba(0,0,0,0.4);">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
          <span style="background: var(--gold-primary); color: #0f1115; font-size: 11px; font-weight: 800; padding: 5px 12px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.5px;">🏢 <%= current_user.tier %> TIER MEMBER</span>
          <h1 style="font-size: 26px; font-weight: 700; margin: 12px 0 6px 0; color: #ffffff;"><%= current_user.complex_name %> 소유주</h1>
          <p style="color: var(--text-sub); font-size: 14px; margin: 0;">동호수: <strong style="color: #ffffff;"><%= current_user.building_number %> <%= current_user.unit_number %></strong> | 무결한 신뢰 자본과 고해상도 네트워크</p>
          <p style="color: var(--text-muted); font-size: 13px; margin-top: 6px; font-style: italic;"><%= @complex&.description %></p>
        </div>
        <div>
          <span style="background: rgba(212, 175, 55, 0.15); color: var(--gold-primary); padding: 8px 16px; border-radius: 20px; font-size: 13px; border: 1px solid var(--gold-primary); font-weight: 600;">💎 VIP 패밀리오피스 연동중</span>
        </div>
      </div>
    </header>
  <% else %>
    <!-- Unauthenticated Guest View (Restricted Teaser) -->
    <header style="margin-bottom: 32px; border: 1px dashed var(--card-border); background: var(--card-bg); padding: 28px; border-radius: 16px; text-align: center;">
      <div style="font-size: 36px; margin-bottom: 8px;">🏢🔒</div>
      <h1 style="font-size: 24px; color: var(--gold-primary); font-weight: 700; margin-bottom: 8px;">ARATEL VVIP 입주민 전용 플랫폼 (게스트 상태)</h1>
      <p style="color: var(--text-muted); font-size: 14px; max-width: 680px; margin: 0 auto 20px auto; line-height: 1.6;">
        특정 입주 단지가 선택되지 않은 <strong>제한적 게스트 화면</strong>입니다.<br>
        소속 입주 단지(디에이치 방배, 한남 더힐 등)로 로그인하시면 <strong>자산 인증, 1:1 패밀리오피스 컨시어지, 조경 오디오 도슨트, 스마트홈 제어</strong> 등 맞춤형 프리미엄 혜택이 개방됩니다.
      </p>
      <div style="display: inline-flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <%= button_to "🔑 데모로그인 (디에이치 방배 GOLD)", demo_login_path(preset: "gold"), method: :post, class: "btn btn-gold btn-sm" %>
        <%= button_to "💎 데모로그인 (한남 더힐 DIAMOND)", demo_login_path(preset: "diamond"), method: :post, class: "btn btn-outline btn-sm", style: "color: var(--gold-primary); border-color: var(--gold-primary);" %>
      </div>
    </header>
  <% end %>

  <!-- Art Docent Section (Aligned with Mobile Audio Docent Card) -->
  <section class="card" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 18px; color: var(--gold-primary); margin: 0; font-weight: 700;">🎧 더샵 갤러리 "조경과 빛" 아트 도슨트</h2>
      <% unless user_signed_in? %>
        <span style="font-size: 11px; color: var(--danger-color); background: rgba(255, 82, 82, 0.15); padding: 4px 10px; border-radius: 12px; font-weight: 600;">🔒 로그인 시 재생 가능</span>
      <% end %>
    </div>
    <% (@art_docents || []).each do |docent| %>
      <div style="background: var(--card-bg-elevated); border: 1px solid var(--card-border); padding: 18px; border-radius: 12px; margin-bottom: 14px;">
        <h3 style="font-size: 16px; color: #ffffff; font-weight: 700; margin-bottom: 6px;"><%= docent.title %></h3>
        <p style="color: var(--text-muted); font-size: 13px; margin-bottom: 12px;"><%= docent.description %></p>
        <% if docent.audio_url.present? && user_signed_in? %>
          <audio controls style="width: 100%;">
            <source src="<%= docent.audio_url %>" type="audio/mpeg">
            오디오 태그를 지원하지 않는 브라우저입니다.
          </audio>
        <% else %>
          <div style="background: #0f1115; padding: 12px; border-radius: 8px; color: var(--text-muted); font-size: 13px; text-align: center; border: 1px solid var(--card-border);">
            🔒 단지 인증 입주민 전용 고음질 AAC/WebP 오디오 플레이어입니다.
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <!-- Facility Status Section (Aligned with Mobile Facility Status Card) -->
  <section class="card" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 18px; color: #ffffff; margin: 0; font-weight: 700;">🏢 단지 커뮤니티 시설 운영 현황</h2>
      <% unless user_signed_in? %>
        <span style="font-size: 11px; color: var(--warning-color); background: rgba(255, 167, 38, 0.15); padding: 4px 10px; border-radius: 12px; font-weight: 600;">🔒 미리보기 모드</span>
      <% end %>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
      <% (@facilities_status || []).each do |facility| %>
        <div style="border: 1px solid var(--card-border); padding: 16px; border-radius: 12px; background: var(--card-bg-elevated);">
          <h4 style="font-size: 15px; font-weight: 700; color: #ffffff; margin-bottom: 8px;"><%= facility.facility_name %></h4>
          <p style="margin-bottom: 4px; color: var(--text-sub); font-size: 13px;">혼잡도: <span style="font-weight: 700; color: <%= facility.crowd_level == 'CROWDED' ? 'var(--warning-color)' : (facility.crowd_level == 'NORMAL' ? 'var(--success-color)' : 'var(--danger-color)') %>;"><%= facility.crowd_level %></span></p>
          <p style="color: var(--text-muted); font-size: 12px;">현재 예약 건수: <%= facility.active_reservations %>건</p>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Smart Home State Section -->
  <section class="card" style="margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 18px; color: var(--success-color); margin: 0; font-weight: 700;">💡 스마트 홈 실시간 제어 상태</h2>
      <% unless user_signed_in? %>
        <span style="font-size: 11px; color: var(--danger-color); background: rgba(255, 82, 82, 0.15); padding: 4px 10px; border-radius: 12px; font-weight: 600;">🔒 세대주 인증 필요</span>
      <% end %>
    </div>
    <% if user_signed_in? %>
      <div style="display: flex; gap: 24px; flex-wrap: wrap; background: var(--card-bg-elevated); padding: 18px; border-radius: 12px; color: #ffffff; border: 1px solid var(--card-border);">
        <div><strong style="color: var(--gold-primary);">조명:</strong> <%= @smart_home_state[:lighting] %></div>
        <div><strong style="color: var(--gold-primary);">난방/냉방 온도:</strong> <%= @smart_home_state[:hvac_temperature] %>°C</div>
        <div><strong style="color: var(--gold-primary);">환기 모드:</strong> <%= @smart_home_state[:ventilation] %></div>
      </div>
    <% else %>
      <div style="text-align: center; color: var(--text-muted); padding: 16px; background: var(--card-bg-elevated); border-radius: 8px; border: 1px solid var(--card-border); font-size: 13px;">
        🔒 로그인 후 소속 단지의 스마트 홈(조명, 온도, 환기) 실시간 상태를 조회하고 제어할 수 있습니다.
      </div>
    <% end %>
  </section>

  <!-- AI Agent Dialogue Section (Aligned with Mobile #30 Context-Aware AI) -->
  <section class="card">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
      <span style="font-size: 20px;">🤖</span>
      <h2 style="font-size: 18px; color: var(--gold-primary); font-weight: 700; margin: 0;">ARATEL AI 에이전트</h2>
    </div>

    <!-- AI Context Banner (#30) -->
    <div class="ai-context-banner">
      <span>🎯</span>
      <span>현재 화면: 웰컴 홈 대시보드</span>
    </div>

    <!-- 1-Tap Proactive Suggestion Chips (#30) -->
    <div class="suggestion-chips-row">
      <span class="suggestion-chip" onclick="document.getElementById('ai_message_input').value='오늘 자산 가치 변동 요약해줘'">오늘 자산 가치 변동 요약해줘</span>
      <span class="suggestion-chip" onclick="document.getElementById('ai_message_input').value='클럽딜 마감 시간 알려줘'">클럽딜 마감 시간 알려줘</span>
      <span class="suggestion-chip" onclick="document.getElementById('ai_message_input').value='시설 혼잡도 최신 현황'">시설 혼잡도 최신 현황</span>
    </div>

    <% if @reply.present? %>
      <div style="background: rgba(0, 230, 118, 0.15); border-left: 4px solid var(--success-color); padding: 14px; margin-bottom: 16px; border-radius: 8px;">
        <p style="color: #6ee7b7; font-weight: 700; font-size: 14px; margin: 0;"><%= @reply %></p>
      </div>
    <% end %>

    <%= form_with url: agent_dialogue_home_path, method: :post, local: true do |f| %>
      <div style="display: flex; gap: 8px;">
        <%= f.text_field :message, id: "ai_message_input", placeholder: user_signed_in? ? "자연어로 요청해보세요 (예: 라운지 조식 2명 예약해줘)" : "로그인 후 AI 음성/자연어 제어를 이용하실 수 있습니다", disabled: !user_signed_in?, class: "form-control", style: "flex: 1;" %>
        <%= f.submit "전송", disabled: !user_signed_in?, class: "btn btn-gold", style: "cursor: #{user_signed_in? ? 'pointer' : 'not-allowed'};" %>
      </div>
    <% end %>
  </section>
</div>

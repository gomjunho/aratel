<% if @complex.present? %>
  <style>
    :root {
      --complex-primary: <%= @complex.primary_color %>;
      --complex-secondary: <%= @complex.secondary_color %>;
      --complex-accent: <%= @complex.accent_color %>;
    }
  </style>
<% end %>

<div class="welcome-home-container" style="padding: 24px; max-width: 1000px; margin: 0 auto; font-family: 'Noto Sans KR', sans-serif;">
  <% if user_signed_in? %>
    <!-- Authenticated Resident View with Dynamic Complex Theme -->
    <header style="margin-bottom: 32px; border-bottom: 3px solid <%= @complex&.accent_color || '#2563eb' %>; background: linear-gradient(135deg, <%= @complex&.secondary_color || '#1e293b' %>, <%= @complex&.primary_color || '#0f172a' %>); color: #fff; padding: 28px; border-radius: 14px; box-shadow: 0 8px 24px rgba(0,0,0,0.4);">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
          <span style="background: <%= @complex&.accent_color || '#2563eb' %>; color: #0f172a; font-size: 12px; font-weight: 800; padding: 5px 10px; border-radius: 6px; text-transform: uppercase;">🏢 <%= @complex_name %> 전용 브랜딩 테마</span>
          <h1 style="font-size: 28px; font-weight: 700; margin: 10px 0 6px 0; color: #ffffff;"><%= @complex&.banner_title.presence || "🏠 #{@complex_name} 디지털 웰컴 홈" %></h1>
          <p style="color: #f1f5f9; font-size: 15px; margin: 0;">동호수: <strong style="color: #ffffff;"><%= current_user.building_number %> <%= current_user.unit_number %></strong> | 멤버십: <strong style="color: <%= @complex&.accent_color || '#fbbf24' %>;"><%= current_user.tier %></strong></p>
          <p style="color: #cbd5e1; font-size: 13px; margin-top: 6px; font-style: italic;"><%= @complex&.description %></p>
        </div>
        <div>
          <span style="background: rgba(255,255,255,0.15); color: #ffffff; padding: 10px 18px; border-radius: 20px; font-size: 14px; border: 1px solid rgba(255,255,255,0.3); font-weight: 600;">✨ 어드민 테마 (<%= @complex&.primary_color %> / <%= @complex&.accent_color %>)</span>
        </div>
      </div>
    </header>
  <% else %>
    <!-- Unauthenticated Guest View (Restricted Teaser) -->
    <header style="margin-bottom: 32px; border: 1px dashed #cbd5e1; background: #0f172a; padding: 24px; border-radius: 12px; text-align: center;">
      <div style="font-size: 36px; margin-bottom: 8px;">🏢🔒</div>
      <h1 style="font-size: 26px; color: #ffffff; font-weight: 700; margin-bottom: 8px;">ARATEL 하이엔드 입주민 전용 포털 (게스트 미인증 상태)</h1>
      <p style="color: #cbd5e1; font-size: 15px; max-width: 680px; margin: 0 auto 20px auto; line-height: 1.6;">
        현재 특정 입주 단지가 선택되지 않은 <strong>제한적 게스트 화면</strong>입니다.<br>
        소속 입주 단지(디에이치 방배, 한남 더힐 등)로 인증 로그인하시면 <strong>단지별 어드민 커스텀 테마 색상, 실시간 스마트홈 제어, 조경 오디오 도슨트, 커뮤니티 예약</strong> 등 단지 맞춤형 혜택이 개방됩니다.
      </p>
      <div style="display: inline-flex; gap: 12px; justify-content: center;">
        <%= button_to "🔑 데모로그인 (디에이치 방배)", demo_login_path(preset: "gold"), method: :post, style: "padding: 12px 24px; background: #2563eb; color: #fff; border: none; border-radius: 8px; font-weight: 700; cursor: pointer;" %>
        <%= button_to "💎 데모로그인 (한남 더힐 VVIP)", demo_login_path(preset: "diamond"), method: :post, style: "padding: 12px 24px; background: #0f172a; color: #fbbf24; border: 1px solid #fbbf24; border-radius: 8px; font-weight: 700; cursor: pointer;" %>
      </div>
    </header>
  <% end %>

  <!-- Art Docent Section -->
  <section style="margin-bottom: 32px; background: #0f172a; border: 1px solid #1e293b; padding: 24px; border-radius: 12px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 20px; color: #38bdf8; margin: 0; font-weight: 700;">🎨 조경 아트 도슨트</h2>
      <% unless user_signed_in? %>
        <span style="font-size: 13px; color: #f43f5e; background: #881337; padding: 4px 10px; border-radius: 12px; font-weight: 600;">🔒 로그인 시 재생 가능</span>
      <% end %>
    </div>
    <% (@art_docents || []).each do |docent| %>
      <div class="docent-card" style="background: #1e293b; border: 1px solid #334155; padding: 18px; border-radius: 10px; margin-bottom: 14px;">
        <h3 style="font-size: 18px; color: #ffffff; font-weight: 700; margin-bottom: 8px;"><%= docent.title %></h3>
        <p style="color: #cbd5e1; font-size: 14px; margin-bottom: 12px;"><%= docent.description %></p>
        <% if docent.audio_url.present? && user_signed_in? %>
          <audio controls style="width: 100%;">
            <source src="<%= docent.audio_url %>" type="audio/mpeg">
            오디오 태그를 지원하지 않는 브라우저입니다.
          </audio>
        <% else %>
          <div style="background: #090d16; padding: 12px; border-radius: 6px; color: #94a3b8; font-size: 14px; text-align: center;">
            🔒 단지 인증 입주민 전용 오디오 플레이어입니다. (로그인 필요)
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <!-- Facility Status Section -->
  <section style="margin-bottom: 32px; background: #0f172a; border: 1px solid #1e293b; padding: 24px; border-radius: 12px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 20px; color: #fbbf24; margin: 0; font-weight: 700;">🏢 단지 커뮤니티 시설 혼잡도 & 예약</h2>
      <% unless user_signed_in? %>
        <span style="font-size: 13px; color: #f43f5e; background: #881337; padding: 4px 10px; border-radius: 12px; font-weight: 600;">🔒 미리보기 모드</span>
      <% end %>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
      <% (@facilities_status || []).each do |facility| %>
        <div style="border: 1px solid #334155; padding: 18px; border-radius: 10px; background: #1e293b;">
          <h4 style="font-size: 16px; font-weight: 700; color: #ffffff; margin-bottom: 8px;"><%= facility.facility_name %></h4>
          <p style="margin-bottom: 4px; color: #cbd5e1;">혼잡도: <span style="font-weight: 700; color: <%= facility.crowd_level == 'CROWDED' ? '#f43f5e' : (facility.crowd_level == 'NORMAL' ? '#fbbf24' : '#4ade80') %>;"><%= facility.crowd_level %></span></p>
          <p style="color: #94a3b8; font-size: 14px;">현재 예약 건수: <%= facility.active_reservations %>건</p>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Smart Home State Section -->
  <section style="margin-bottom: 32px; background: #0f172a; border: 1px solid #1e293b; padding: 24px; border-radius: 12px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 20px; color: #4ade80; margin: 0; font-weight: 700;">💡 스마트 홈 실시간 제어 상태</h2>
      <% unless user_signed_in? %>
        <span style="font-size: 13px; color: #f43f5e; background: #881337; padding: 4px 10px; border-radius: 12px; font-weight: 600;">🔒 세대주 인증 필요</span>
      <% end %>
    </div>
    <% if user_signed_in? %>
      <div style="display: flex; gap: 24px; flex-wrap: wrap; background: #1e293b; padding: 18px; border-radius: 10px; color: #ffffff;">
        <div><strong style="color: #fbbf24;">조명:</strong> <%= @smart_home_state[:lighting] %></div>
        <div><strong style="color: #fbbf24;">난방/냉방 온도:</strong> <%= @smart_home_state[:hvac_temperature] %>°C</div>
        <div><strong style="color: #fbbf24;">환기 모드:</strong> <%= @smart_home_state[:ventilation] %></div>
      </div>
    <% else %>
      <div style="text-align: center; color: #94a3b8; padding: 16px; background: #1e293b; border-radius: 8px;">
        🔒 로그인 후 소속 단지의 스마트 홈(조명, 온도, 환기) 실시간 상태를 조회하고 제어할 수 있습니다.
      </div>
    <% end %>
  </section>

  <!-- AI Agent Dialogue Section -->
  <section style="background: #0f172a; border: 1px solid #334155; padding: 24px; border-radius: 12px;">
    <h2 style="font-size: 20px; color: #ffffff; font-weight: 700; margin-bottom: 16px;">🤖 AI 에이전트 음성 & 자연어 제어</h2>
    <% if @reply.present? %>
      <div style="background: #064e3b; border-left: 4px solid #10b981; padding: 14px; margin-bottom: 16px; border-radius: 6px;">
        <p style="color: #a7f3d0; font-weight: 700; font-size: 15px;"><%= @reply %></p>
      </div>
    <% end %>
    <%= form_with url: agent_dialogue_home_path, method: :post, local: true do |f| %>
      <div style="display: flex; gap: 8px;">
        <%= f.text_field :message, placeholder: user_signed_in? ? "예: 라운지 조식 2명 예약해줘" : "로그인 후 AI 음성/자연어 제어를 이용하실 수 있습니다", disabled: !user_signed_in?, style: "flex: 1; padding: 12px; background: #1e293b; color: #ffffff; border: 1px solid #334155; border-radius: 8px; font-size: 14px;" %>
        <%= f.submit "전송", disabled: !user_signed_in?, style: "padding: 12px 24px; background: #{user_signed_in? ? (@complex&.primary_color || '#2563eb') : '#475569'}; color: #ffffff; border: none; border-radius: 8px; cursor: #{user_signed_in? ? 'pointer' : 'not-allowed'}; font-weight: 700;" %>
      </div>
    <% end %>
  </section>
</div>

<div style="max-width: 680px; margin: 0 auto; padding: 24px; font-family: sans-serif;">
  <header style="margin-bottom: 24px;">
    <h1 style="font-size: 24px; color: #fff; font-weight: 700;">✏️ 커뮤니티 게시글 작성</h1>
    <p style="color: #94a3b8; font-size: 14px;">게시판 선택에 따라 작성자 표기 방식이 자동으로 적용됩니다.</p>
  </header>

  <%= form_with model: @community_post, local: true do |f| %>
    <div style="margin-bottom: 20px;">
      <label style="display: block; color: #cbd5e1; font-weight: 600; margin-bottom: 8px;">게시판 선택</label>
      <%= f.select :board_type, [
        ["🌐 전체 공동 게시판 ([단지명] [닉네임] 표기)", "GLOBAL"],
        ["🏢 #{current_user.complex_name} 기명 게시판 ([#{current_user.building_number}] [닉네임] 표기)", "COMPLEX_NAMED"],
        ["🔒 #{current_user.complex_name} 완전 익명 게시판 (100% 익명)", "COMPLEX_ANONYMOUS"]
      ], { selected: @board_type }, style: "width: 100%; padding: 12px; background: #0f172a; border: 1px solid #334155; border-radius: 8px; color: #fff; font-size: 15px;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <label style="display: block; color: #cbd5e1; font-weight: 600; margin-bottom: 8px;">닉네임 (기명 게시판 선택 시 사용)</label>
      <%= f.text_field :nickname, value: current_user.name, placeholder: "예: 푸른하늘", style: "width: 100%; padding: 12px; background: #0f172a; border: 1px solid #334155; border-radius: 8px; color: #fff; font-size: 15px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <label style="display: block; color: #cbd5e1; font-weight: 600; margin-bottom: 8px;">글 제목</label>
      <%= f.text_field :title, placeholder: "제목을 입력하세요", required: true, style: "width: 100%; padding: 12px; background: #0f172a; border: 1px solid #334155; border-radius: 8px; color: #fff; font-size: 15px; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 24px;">
      <label style="display: block; color: #cbd5e1; font-weight: 600; margin-bottom: 8px;">본문 내용</label>
      <%= f.text_area :content, rows: 8, placeholder: "입주민들과 공유할 내용을 자유롭게 입력하세요", required: true, style: "width: 100%; padding: 12px; background: #0f172a; border: 1px solid #334155; border-radius: 8px; color: #fff; font-size: 15px; box-sizing: border-box;" %>
    </div>

    <div style="display: flex; gap: 12px; justify-content: flex-end;">
      <%= link_to "취소", community_posts_path, style: "padding: 12px 24px; background: #334155; color: #fff; text-decoration: none; border-radius: 8px; font-weight: 600;" %>
      <%= f.submit "게시글 등록", style: "padding: 12px 28px; background: var(--complex-primary, #2563eb); color: #fff; border: none; border-radius: 8px; font-weight: 700; cursor: pointer;" %>
    </div>
  <% end %>
</div>

<div class="form-container">
  <div class="card">
    <h1>VVIP 자산 증빙 제출 | Tier Evidence Submission</h1>
    <p class="subtitle">소득금액증명원, 잔고 증명서, 등기완료통지서 및 추천인 정보를 통한 VVIP 멤버십 등급 심사</p>

    <%= form_with model: @tier_evidence, url: tier_evidences_path, local: true do |f| %>
      <div class="form-group">
        <%= f.label :target_tier, "희망 멤버십 등급" %>
        <%= f.select :target_tier, [["Diamond (다이아몬드)", "DIAMOND"], ["Platinum (플래티넘)", "PLATINUM"], ["Gold (골드)", "GOLD"]], {}, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :evidence_type, "증빙 서류 유형" %>
        <%= f.select :evidence_type, [
          ["소득금액증명원 (INCOME_CERT)", "INCOME_CERT"],
          ["금융자산/잔고증명서 (BALANCE_CERT)", "BALANCE_CERT"],
          ["등기완료통지서/소유권증명 (DEED)", "DEED"],
          ["기타 고가치 자산증빙 (OTHER)", "OTHER"]
        ], {}, class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :document_url, "증빙 서류 URL (안전 암호화 저장소)" %>
        <%= f.text_field :document_url, placeholder: "https://storage.aratel.com/docs/income_2025.pdf", class: "form-control", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :instagram_handle, "인스타그램 핸들 (선택)" %>
        <%= f.text_field :instagram_handle, placeholder: "@vip_user", class: "form-control" %>
      </div>

      <div class="form-group">
        <%= f.label :referral_code, "추천인 코드 (선택)" %>
        <%= f.text_field :referral_code, placeholder: "DIAMOND_777", class: "form-control" %>
      </div>

      <div class="form-actions">
        <%= f.submit "자산 증빙 심사 제출", class: "btn btn-gold btn-lg" %>
        <%= link_to "취소", verification_path, class: "btn btn-outline" %>
      </div>
    <% end %>
  </div>
</div>

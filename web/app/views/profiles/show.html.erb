<div class="profile-container" style="max-width: 800px; margin: 0 auto; padding: 24px; font-family: 'Noto Sans KR', sans-serif;">
  <header style="margin-bottom: 28px; border-bottom: 2px solid var(--complex-primary, #2563eb); padding-bottom: 16px;">
    <h1 style="font-size: 26px; font-weight: 700; color: #fff;">👤 내 정보 및 자산 인증 관리</h1>
    <p style="color: #94a3b8; font-size: 14px; margin-top: 4px;">입주민 프로필 관리 및 등기부 연동 자산 인증 설정 공간입니다.</p>
  </header>

  <!-- Profile Card -->
  <div style="background: #0f172a; border: 1px solid #1e293b; border-radius: 14px; padding: 28px; margin-bottom: 28px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #334155; padding-bottom: 16px;">
      <div>
        <h2 style="font-size: 22px; color: #fff; font-weight: 700;"><%= @user.name %> 님</h2>
        <p style="color: #94a3b8; font-size: 14px; margin-top: 4px;">연락처: <%= @user.phone_number %> | 생년월일: <%= @user.birth_date %></p>
      </div>
      <span style="background: var(--complex-primary, #2563eb); color: #fff; padding: 8px 16px; border-radius: 20px; font-size: 14px; font-weight: 700;">
        💎 <%= @user.tier %> 회원
      </span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
      <div style="background: #1e293b; padding: 16px; border-radius: 10px;">
        <span style="color: #64748b; font-size: 12px; font-weight: 600; display: block;">소속 단지 및 동호수</span>
        <span style="color: #fbbf24; font-size: 16px; font-weight: 700; margin-top: 4px; display: block;">
          🏢 <%= @user.complex_name %> <%= @user.building_number %> <%= @user.unit_number %>
        </span>
      </div>
      <div style="background: #1e293b; padding: 16px; border-radius: 10px;">
        <span style="color: #64748b; font-size: 12px; font-weight: 600; display: block;">소유 뱃지 목록</span>
        <div style="display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap;">
          <% (@user.badges_list || []).each do |badge| %>
            <span style="background: #334155; color: #38bdf8; font-size: 12px; font-weight: 700; padding: 3px 8px; border-radius: 4px;"><%= badge %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Asset Verification Card -->
  <section style="background: #0f172a; border: 1px solid rgba(212, 175, 55, 0.4); border-radius: 14px; padding: 28px;">
    <h3 style="font-size: 20px; color: #fbbf24; font-weight: 700; margin-bottom: 8px;">🔐 자산 인증 및 등기부 연동 관리</h3>
    <p style="color: #cbd5e1; font-size: 14px; margin-bottom: 24px;">소유 등기부 실시간 확인 및 VVIP 자산 증빙 서류 제출을 진행할 수 있습니다.</p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
      <%= link_to verification_path, style: "background: #1e293b; border: 1px solid #334155; padding: 20px; border-radius: 12px; text-decoration: none; display: block;" do %>
        <h4 style="color: #38bdf8; font-size: 16px; font-weight: 700; margin-bottom: 6px;">🔐 본인확인 & 등기부 연동 대시보드</h4>
        <p style="color: #94a3b8; font-size: 13px;">KCB 본인확인 및 대법원 등기부 연동 상태 조회</p>
      <% end %>

      <%= link_to new_tier_evidence_path, style: "background: #1e293b; border: 1px solid #334155; padding: 20px; border-radius: 12px; text-decoration: none; display: block;" do %>
        <h4 style="color: #fbbf24; font-size: 16px; font-weight: 700; margin-bottom: 6px;">📄 VVIP 자산 증빙 서류 제출</h4>
        <p style="color: #94a3b8; font-size: 13px;">소득증명, SNS, 추천인 코드 등 증빙 제출</p>
      <% end %>
    </div>
  </section>
</div>

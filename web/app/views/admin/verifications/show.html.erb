<div class="dashboard-header">
  <h1>🔍 서류 심사 상세 정보</h1>
  <p class="subtitle">제출된 자산 증빙 서류의 무결성을 검증하고 승인/반려합니다.</p>
</div>

<div class="card max-w-lg">
  <% if @is_delegation %>
    <h2>👥 가족 및 대리인 권한 위임 심사</h2>
    <p><strong>신청자:</strong> <%= @item.user.name %> (<%= @item.user.phone_number %>)</p>
    <p><strong>위임 관계:</strong> <%= @item.relationship %></p>
    <p><strong>현재 상태:</strong> <span class="status-tag status-<%= @item.status.downcase %>"><%= @item.status %></span></p>
    <p class="my-3">
      <strong>제출 서류:</strong>
      <a href="<%= @item.document_url %>" target="_blank" class="link-preview">첨부 파일 열기 🔗</a>
    </p>

    <% if @item.status == "PENDING_OWNER_APPROVAL" || @item.status == "UNDER_REVIEW" %>
      <div class="flex gap-2 mt-4">
        <%= button_to "승인하기", approve_delegation_admin_verification_path(@item), method: :post, class: "btn btn-success" %>
        <%= button_to "반려하기", reject_delegation_admin_verification_path(@item), method: :post, class: "btn btn-danger" %>
      </div>
    <% end %>

  <% else %>
    <h2>📄 VVIP 자산 증빙 서류 심사</h2>
    <p><strong>회원명:</strong> <%= @item.user.name %> (<%= @item.user.phone_number %>)</p>
    <p><strong>현재 등급:</strong> <span class="badge badge-gold_emblem"><%= @item.user.tier %></span></p>
    <p><strong>목표 승급 등급:</strong> <span class="badge badge-diamond_black"><%= @item.target_tier %></span></p>
    <p><strong>증빙 서류 유형:</strong> <%= @item.evidence_type %></p>
    <% if @item.instagram_handle.present? %>
      <p><strong>인스타그램:</strong> <%= @item.instagram_handle %></p>
    <% end %>
    <% if @item.referral_code.present? %>
      <p><strong>추천인 코드:</strong> <%= @item.referral_code %></p>
    <% end %>
    <p><strong>현재 심사 상태:</strong> <span class="status-tag status-<%= @item.status.downcase %>"><%= @item.status %></span></p>

    <p class="my-3">
      <strong>첨부 증빙 서류:</strong>
      <a href="<%= @item.document_url %>" target="_blank" class="link-preview">원본 증빙 파일 보기 🔗</a>
    </p>

    <% if @item.status == "UNDER_REVIEW" %>
      <%= form_with url: approve_tier_evidence_admin_verification_path(@item), method: :post, local: true, class: "mt-4" do |f| %>
        <div class="form-group">
          <%= f.label :admin_notes, "심사 의견 (선택)" %>
          <%= f.text_area :admin_notes, class: "form-control", rows: 2, placeholder: "승인/반려 사유 입력" %>
        </div>
        <div class="flex gap-2">
          <%= f.submit "승인 (등급 상향)", class: "btn btn-success" %>
          <%= button_to "반려하기", reject_tier_evidence_admin_verification_path(@item), method: :post, class: "btn btn-danger" %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <div class="mt-4">
    <a href="<%= admin_verifications_path %>" class="btn btn-secondary">← 대기열 목록으로 돌아가기</a>
  </div>
</div>

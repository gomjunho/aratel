<div class="admin-header">
  <h1>⚙️ 관리자 인증 심사 대기열</h1>
  <p class="subtitle">VVIP 자산 증빙 서류 및 가족/대리인 권한 위임 수동 검증 센터</p>

  <div class="filter-bar mt-3">
    <a href="<%= admin_verifications_path %>" class="filter-chip <%= 'active' if @status_filter.blank? %>">전체 보기</a>
    <a href="<%= admin_verifications_path(status: 'UNDER_REVIEW') %>" class="filter-chip <%= 'active' if @status_filter == 'UNDER_REVIEW' %>">심사 대기 중</a>
    <a href="<%= admin_verifications_path(status: 'APPROVED') %>" class="filter-chip <%= 'active' if @status_filter == 'APPROVED' %>">승인됨</a>
    <a href="<%= admin_verifications_path(status: 'REJECTED') %>" class="filter-chip <%= 'active' if @status_filter == 'REJECTED' %>">반려됨</a>
  </div>
</div>

<div class="grid grid-2 mt-4">
  <!-- 자산 증빙 서류 심사 -->
  <div class="card">
    <h2>📄 VVIP 자산 증빙 서류 대기열</h2>
    <% if @tier_evidences.empty? %>
      <p class="text-muted">해당하는 자산 증빙 서류가 없습니다.</p>
    <% else %>
      <table class="table">
        <thead>
          <tr>
            <th>회원명</th>
            <th>서류 유형</th>
            <th>목표 등급</th>
            <th>상태</th>
            <th>관리</th>
          </tr>
        </thead>
        <tbody>
          <% @tier_evidences.each do |evidence| %>
            <tr>
              <td><%= evidence.user.name %></td>
              <td><%= evidence.evidence_type %></td>
              <td><span class="badge badge-gold_emblem"><%= evidence.target_tier %></span></td>
              <td><span class="status-tag status-<%= evidence.status.downcase %>"><%= evidence.status %></span></td>
              <td>
                <a href="<%= admin_verification_path(evidence) %>" class="btn btn-xs btn-outline">상세 심사 ➔</a>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <!-- 권한 위임 심사 -->
  <div class="card">
    <h2>👥 대리인 및 가족 위임 대기열</h2>
    <% if @delegations.empty? %>
      <p class="text-muted">해당하는 권한 위임 신청이 없습니다.</p>
    <% else %>
      <table class="table">
        <thead>
          <tr>
            <th>신청자</th>
            <th>관계</th>
            <th>증명서</th>
            <th>상태</th>
            <th>관리</th>
          </tr>
        </thead>
        <tbody>
          <% @delegations.each do |delegation| %>
            <tr>
              <td><%= delegation.user.name %></td>
              <td><%= delegation.relationship %></td>
              <td><a href="<%= delegation.document_url %>" target="_blank" class="link-preview">증명서 보기 🔗</a></td>
              <td><span class="status-tag status-<%= delegation.status.downcase %>"><%= delegation.status %></span></td>
              <td>
                <a href="<%= admin_verification_path(delegation, type: 'delegation') %>" class="btn btn-xs btn-outline">상세 심사 ➔</a>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

<div class="insight-container" style="padding: 24px; max-width: 1040px; margin: 0 auto; font-family: 'Noto Sans KR', sans-serif;">
  <!-- Main Title Banner -->
  <header style="margin-bottom: 24px; border-bottom: 2px solid var(--complex-primary, #2563eb); padding-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
      <h1 style="font-size: 28px; font-weight: 900; color: #fff;">📊 자산 증식 인사이트</h1>
      <p style="color: #94a3b8; font-size: 15px; margin-top: 4px;">아파트 실거래가 분석부터 급매물 특가, 트렌드 뉴스 및 VVIP 자산 투자 제안까지 원스톱 인텔리전스</p>
    </div>
    <span style="background: var(--complex-primary, #2563eb); color: #fff; padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 700;">
      🏢 <%= @complex_name %> 데이터 센터
    </span>
  </header>

  <!-- 5 Wealth Intelligence Cards Summary Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 32px;">
    <div style="background: #0f172a; border: 1px solid #334155; padding: 16px; border-radius: 12px; text-align: center;">
      <span style="color: #38bdf8; font-size: 22px;">🏢</span>
      <h4 style="color: #fff; font-size: 15px; font-weight: 700; margin-top: 4px;">실거래가 분석</h4>
      <p style="color: #94a3b8; font-size: 12px; margin-top: 2px;">층수별 최고가 트래킹</p>
    </div>
    <div style="background: #0f172a; border: 1px solid #f43f5e; padding: 16px; border-radius: 12px; text-align: center;">
      <span style="color: #f43f5e; font-size: 22px;">🔥</span>
      <h4 style="color: #fff; font-size: 15px; font-weight: 700; margin-top: 4px;">급매물 포착</h4>
      <p style="color: #fb7185; font-size: 12px; margin-top: 2px;">시세 대비 최대 9% 차익</p>
    </div>
    <div style="background: #0f172a; border: 1px solid #334155; padding: 16px; border-radius: 12px; text-align: center;">
      <span style="color: #fbbf24; font-size: 22px;">📰</span>
      <h4 style="color: #fff; font-size: 15px; font-weight: 700; margin-top: 4px;">트렌드 & 절세</h4>
      <p style="color: #94a3b8; font-size: 12px; margin-top: 2px;">AI 큐레이션 정밀 뉴스</p>
    </div>
    <div style="background: #0f172a; border: 1px solid #334155; padding: 16px; border-radius: 12px; text-align: center;">
      <span style="color: #4ade80; font-size: 22px;">📊</span>
      <h4 style="color: #fff; font-size: 15px; font-weight: 700; margin-top: 4px;">입주 독성 지수</h4>
      <p style="color: #4ade80; font-size: 12px; margin-top: 2px;">안정적인 LOW 위험도</p>
    </div>
    <div style="background: #0f172a; border: 1px solid #a855f7; padding: 16px; border-radius: 12px; text-align: center;">
      <span style="color: #c084fc; font-size: 22px;">💡</span>
      <h4 style="color: #fff; font-size: 15px; font-weight: 700; margin-top: 4px;">자산 증식 제안</h4>
      <p style="color: #c084fc; font-size: 12px; margin-top: 2px;">연 8.5% 프라이빗 딜</p>
    </div>
  </div>

  <!-- SECTION 1: Real Estate Transactions Scatter Plot & Analysis -->
  <section style="background: #0f172a; border: 1px solid #1e293b; border-radius: 14px; padding: 24px; margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 20px; font-weight: 700; color: #38bdf8;">🏢 1. <%= @complex_name %> 실거래가 & 층수별 산점도 분석</h2>
      <span style="color: #94a3b8; font-size: 13px;">국토교통부 실거래 데이터 연동</span>
    </div>

    <!-- Scatter Plot Mock Visualizer -->
    <div style="background: #020617; border: 1px solid #334155; padding: 20px; border-radius: 12px; margin-bottom: 20px; text-align: center;">
      <h3 style="color: #f8fafc; font-size: 16px; margin-bottom: 8px;">층수 vs 실거래가 매핑 차트 (84m² 기준)</h3>
      <div style="background: #0f172a; border: 1px dashed #475569; height: 160px; border-radius: 8px; display: flex; align-items: center; justify-content: center; gap: 30px;">
        <% (@transactions || []).each do |tx| %>
          <div style="background: #1e293b; border: 1px solid #38bdf8; padding: 10px 16px; border-radius: 8px; text-align: center;">
            <span style="color: #fbbf24; font-weight: 800; font-size: 15px; block"><%= tx.floor %>층</span>
            <span style="color: #fff; font-weight: 700; font-size: 16px; block; margin-top: 2px;"><%= number_with_delimiter(tx.price / 100000000.0) %>억원</span>
            <span style="color: #64748b; font-size: 11px; block; margin-top: 2px;"><%= tx.deal_date %></span>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- SECTION 2: Urgent Emergency Deals Notification -->
  <section style="background: #0f172a; border: 1px solid #f43f5e; border-radius: 14px; padding: 24px; margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 20px; font-weight: 700; color: #f43f5e;">🔥 2. 급매물 & 시세 이하 한정 특가 매물 포착</h2>
      <span style="background: #881337; color: #fecdd3; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">실시간 알림</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px;">
      <% (@urgent_deals || []).each do |deal| %>
        <div style="background: #1e293b; border: 1px solid #9f1239; border-radius: 10px; padding: 18px;">
          <span style="background: #f43f5e; color: #fff; font-size: 11px; font-weight: 800; padding: 2px 6px; border-radius: 4px;">급매물</span>
          <h3 style="font-size: 17px; font-weight: 700; color: #fff; margin: 6px 0 4px 0;"><%= deal[:unit] %></h3>
          <p style="color: #94a3b8; font-size: 13px; text-decoration: line-through;">정상 시세: <%= number_with_delimiter(deal[:market_price] / 100000000.0) %>억원</p>
          <p style="color: #fbbf24; font-size: 20px; font-weight: 900; margin-top: 2px;">급매가: <%= number_with_delimiter(deal[:urgent_price] / 100000000.0) %>억원 <span style="color: #f43f5e; font-size: 14px;">(▼ <%= deal[:discount] %>)</span></p>
          <p style="color: #cbd5e1; font-size: 13px; margin-top: 8px; background: #0f172a; padding: 8px; border-radius: 6px;">💡 매각 사유: <%= deal[:reason] %></p>
        </div>
      <% end %>
    </div>
  </section>

  <!-- SECTION 3: Wealth News & Trends -->
  <section style="background: #0f172a; border: 1px solid #1e293b; border-radius: 14px; padding: 24px; margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 20px; font-weight: 700; color: #fbbf24;">📰 3. 부동산 트렌드 & 하이엔드 절세 정밀 뉴스</h2>
      <span style="color: #94a3b8; font-size: 13px;">AI 자산 분석 큐레이션</span>
    </div>

    <div style="display: flex; flex-direction: column; gap: 14px;">
      <% (@wealth_news || []).each do |news| %>
        <div style="background: #1e293b; border: 1px solid #334155; border-radius: 10px; padding: 18px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <span style="background: #334155; color: #fbbf24; font-size: 12px; font-weight: 700; padding: 3px 8px; border-radius: 4px;"><%= news[:tag] %></span>
            <span style="color: #64748b; font-size: 12px;"><%= news[:date] %></span>
          </div>
          <h3 style="font-size: 17px; font-weight: 700; color: #fff; margin-bottom: 4px;"><%= news[:title] %></h3>
          <p style="color: #cbd5e1; font-size: 14px;"><%= news[:summary] %></p>
        </div>
      <% end %>
    </div>
  </section>

  <!-- SECTION 4: Supply Gas Risk Index -->
  <section style="background: #0f172a; border: 1px solid #166534; border-radius: 14px; padding: 24px; margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
      <h2 style="font-size: 20px; font-weight: 700; color: #4ade80;">📊 4. 입주 물량 & 가스(입주 독성) 위험 지수</h2>
      <span style="background: #166534; color: #86efac; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">안전 (LOW RISK)</span>
    </div>
    <div style="background: #1e293b; padding: 16px; border-radius: 10px;">
      <p style="color: #fff; font-size: 16px; font-weight: 700;">향후 2년간 주변 입주 예정 물량: <%= number_with_delimiter(@supply_gas_index[:upcoming_supply_units]) %> 세대</p>
      <p style="color: #cbd5e1; font-size: 14px; margin-top: 6px;"><%= @supply_gas_index[:analysis_summary] %></p>
    </div>
  </section>

  <!-- SECTION 5: Private Wealth Investment Proposals -->
  <section style="background: #0f172a; border: 1px solid #a855f7; border-radius: 14px; padding: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <h2 style="font-size: 20px; font-weight: 700; color: #c084fc;">💡 5. VVIP 자산 증식 & 부동산 프라이빗 투자 제안</h2>
      <span style="background: #581c87; color: #e9d5ff; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">전용 파트너십</span>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px;">
      <% (@investment_proposals || []).each do |prop| %>
        <div style="background: #1e293b; border: 1px solid #581c87; border-radius: 10px; padding: 20px;">
          <span style="background: #a855f7; color: #fff; font-size: 11px; font-weight: 800; padding: 2px 6px; border-radius: 4px;"><%= prop[:category] %></span>
          <h3 style="font-size: 17px; font-weight: 700; color: #fff; margin: 6px 0 8px 0;"><%= prop[:title] %></h3>
          <p style="color: #4ade80; font-size: 18px; font-weight: 800;">기대 수익률: <%= prop[:expected_yield] %></p>
          <p style="color: #94a3b8; font-size: 13px; margin-top: 4px;">최소 참여 자금: <%= prop[:min_investment] %> | 상태: <%= prop[:status] %></p>
        </div>
      <% end %>
    </div>
  </section>
</div>
